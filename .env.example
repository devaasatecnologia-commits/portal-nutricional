# Copie para .env local e obtenha valores de desenvolvimento pelo processo seguro.
# Nunca substitua valores em branco por credenciais de producao.

# PostgreSQL de desenvolvimento/homologacao
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
TIMEZONE=America/Sao_Paulo

# Obrigatorios pelo bootstrap. Gere valores exclusivos para cada ambiente.
CHAVE_SECRETA=
API_TOKEN=
CRON_TOKEN=

# Usado por alguns handlers de tokens; configure uma chave forte mesmo que o
# bootstrap nao o exija globalmente.
JWT_SECRET=

# Tokens opcionais de integracoes legadas
TOKEN_EMAIL=
TOKEN_GESTORES=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Cobli
COBLI_API_KEY=
COBLI_WEBHOOK_SECRET=

# SMTP
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=

# Redis (opcional)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Aplicacao
LOG_LEVEL=info
APP_ENV=development
API_URL=http://localhost:8080
ADMIN_EMAIL=

# ERP: true mantem modo sandbox; nao altere sem aprovacao do responsavel ERP.
ERP_PEDIDO_SANDBOX=true

# Valhalla opcional
VALHALLA_URL=
VALHALLA_TIMEOUT=12
TRUCK_HEIGHT=4.0
TRUCK_WIDTH=2.5
TRUCK_LENGTH=12.0
TRUCK_WEIGHT=3500
TRUCK_FIXED_SPEED=35

# Saldo Flex (API Mercos): URL por filial e token opcionais
#FLEX_API_URL_F1=http://mercosf1.nutricionalbr.com:8081/saldo_flex
#FLEX_API_URL_F6=http://mercosf1.nutricionalbr.com:8086/saldo_flex
#FLEX_API_TOKEN=
